# 应用基础配置
APP_NAME="CampusJob-Agent"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# 本地数据与存储
DATABASE_URL="sqlite+aiosqlite:///./data/campus_job.db"
DATA_DIR="./data"

# LLM 与推理模型配置 (通过 LiteLLM 支持各种模型, 如 deepseek/deepseek-chat, qwen/qwen-turbo, openai/gpt-4o-mini 等)
LLM_MODEL="deepseek/deepseek-chat"
LLM_API_KEY="your_api_key_here"
LLM_API_BASE="https://api.deepseek.com/v1"

# 邮件 SMTP 配置 (支持 QQ邮箱/163邮箱/企业邮箱)
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_USER="your_email@qq.com"
SMTP_PASSWORD="your_smtp_auth_code_here"
SMTP_USE_SSL=true
SMTP_SENDER_NAME="CampusJob-Agent 求职早报"
NOTIFICATION_RECIPIENT_EMAIL="your_receive_email@qq.com"

# 定时任务触发时间 (Cron 或每天具体小时/分钟)
DAILY_BRIEF_HOUR=8
DAILY_BRIEF_MINUTE=0
AUTO_CRAWL_INTERVAL_HOURS=4
